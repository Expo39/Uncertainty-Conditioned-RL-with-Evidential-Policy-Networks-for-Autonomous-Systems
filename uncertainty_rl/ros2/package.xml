<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd"
            schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>uncertainty_rl_ros2</name>
  <version>0.1.0</version>
  <description>
    EKF covariance extraction and CARLA bridge orchestration for
    uncertainty-conditioned RL.
  </description>
  <maintainer email="antoniogaldes2@outlook.com">Antonio Galdes</maintainer>
  <license>MIT</license>

  <buildtool_depend>ament_python</buildtool_depend>

  <exec_depend>rclpy</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>nav_msgs</exec_depend>
  <exec_depend>cartographer_ros_msgs</exec_depend>
  <exec_depend>uncertainty_rl_msgs</exec_depend>
  <exec_depend>robot_localization</exec_depend>
  <exec_depend>tf2_ros</exec_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
