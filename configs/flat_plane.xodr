<?xml version="1.0" encoding="UTF-8"?>
<!--
  @file flat_plane.xodr
  @brief Minimal OpenDRIVE map: a single flat 900x400 m ground plane with no roads,
         buildings, or traffic infrastructure. Used by CARLAParkingEnv instead of
         Town05_Opt so all 3 parking lot floor plans can be placed on clean flat ground.

  World-frame footprint of all lots combined:
    x: -200 to +500  (rectangle at x=-200..-165, trapezoid at x=0..44, irregular_a at x=~200+)
    y: -90  to +50

  Road geometry: road centre line runs east at y=+200 for 900 m starting at x=-300.
  The single right lane (id=-1) has width 400 m, which extends from y=+200 down to
  y=-200, covering all lot y-coordinates. The spectator default position (0,0,z)
  sits inside this footprint so the ground is visible on first load.

  Loaded via client.generate_opendrive_world() not client.load_world().
-->
<OpenDRIVE>
  <header revMajor="1" revMinor="4" name="FlatPlane" version="1.0"
          north="200.0" south="-200.0" east="600.0" west="-300.0"/>
  <road name="FlatGround" length="900.0" id="0" junction="-1">
    <link/>
    <planView>
      <geometry s="0.0" x="-300.0" y="200.0" hdg="0.0" length="900.0">
        <line/>
      </geometry>
    </planView>
    <elevationProfile>
      <elevation s="0.0" a="0.0" b="0.0" c="0.0" d="0.0"/>
    </elevationProfile>
    <lateralProfile/>
    <lanes>
      <laneSection s="0.0">
        <center>
          <lane id="0" type="none" level="false">
            <roadMark sOffset="0.0" type="none"/>
          </lane>
        </center>
        <right>
          <lane id="-1" type="driving" level="false">
            <width sOffset="0.0" a="400.0" b="0.0" c="0.0" d="0.0"/>
            <roadMark sOffset="0.0" type="none"/>
          </lane>
        </right>
      </laneSection>
    </lanes>
  </road>
</OpenDRIVE>
